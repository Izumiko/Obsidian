// use prisma-8
// Printed from prisma/schema.prisma by `prisma contract print`.

namespace public {
  model Category {
    id              String           @id @default(uuid())
    name            String
    description     String?
    icon            String?
    order           Int?
    parentId        String?
    inheritSources  Boolean          @default(true)
    categorySources CategorySource[]
    requests        Request[]
    torrents        Torrent[]
    parent          Category?        @relation(name: "Category_parent", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)
    children        Category[]       @relation(name: "Category_parent")

    @@index([name], map: "Category_name_key", unique: true)
  }

  model UploadedFile {
    id            String                                              @id @default(uuid())
    type          String
    ext           String
    storageKey    String
    size          Int
    mimeType      String
    data          Bytes?
    createdAt     TimestampString(3)                                        @default(now())
    updatedAt     temporal.timestampString(3, onCreate: now, onUpdate: now)
    torrentPoster Torrent?
    userAvatar    User?
  }

  model User {
    id                      String                                              @id @default(uuid())
    email                   String
    passwordHash            String
    username                String
    role                    pg.enum(UserRole)                                   @default("USER")
    status                  pg.enum(UserStatus)                                 @default("ACTIVE")
    upload                  BigInt                                              @default(0)
    download                BigInt                                              @default(0)
    inviteCode              String?
    emailVerified           Boolean                                             @default(false)
    passkey                 String
    createdAt               TimestampString(3)                                        @default(now())
    updatedAt               temporal.timestampString(3, onCreate: now, onUpdate: now)
    bonusPoints             Int                                                 @default(0)
    rssToken                String?
    rssEnabled              Boolean                                             @default(true)
    avatarFileId            String?
    avatarUrl               String?
    preferredLanguage       String?
    allowEmailNotifications Boolean                                             @default(true)
    publicProfile           Boolean                                             @default(false)
    activities              UserActivity[]
    announcements           Announcement[]
    announceRateLimits      AnnounceRateLimit[]
    announces               Announce[]
    bannedUsers             PeerBan[]
    bookmarks               Bookmark[]
    comments                Comment[]
    commentVotes            CommentVote[]
    downloadTokens          DownloadToken[]
    emailVerificationTokens EmailVerificationToken[]
    hitAndRuns              HitAndRun[]
    passwordResetTokens     PasswordResetToken[]
    torrentVotes            TorrentVote[]
    avatarFile              UploadedFile?                                       @relation(fields: [avatarFileId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)
    adminNotifications      Notification[]                                      @relation(name: "Notification_admin")
    invitesCreated          Invite[]                                            @relation(name: "Invite_createdBy")
    invitesUsed             Invite[]                                            @relation(name: "Invite_usedBy")
    notifications           Notification[]                                      @relation(name: "Notification_user")
    rejectedTorrents        Torrent[]                                           @relation(name: "Torrent_rejectedBy")
    requestsCreated         Request[]                                           @relation(name: "Request_user")
    requestsFilled          Request[]                                           @relation(name: "Request_filledBy")
    torrents                Torrent[]                                           @relation(name: "Torrent_uploader")
    wikiPagesCreated        WikiPage[]                                          @relation(name: "WikiPage_createdBy")
    wikiPagesUpdated        WikiPage[]                                          @relation(name: "WikiPage_updatedBy")

    @@index([email], map: "User_email_key", unique: true)
    @@index([username], map: "User_username_key", unique: true)
    @@index([passkey], map: "User_passkey_key", unique: true)
    @@index([rssToken], map: "User_rssToken_key", unique: true)
    @@index([avatarFileId], map: "User_avatarFileId_key", unique: true)
    @@index([rssToken], map: "User_rssToken_idx")
  }

  model Torrent {
    id              String                                              @id @default(uuid())
    infoHash        String
    name            String
    description     String?
    uploaderId      String
    filePath        String
    nfoPath         String?
    size            BigInt
    isApproved      Boolean                                             @default(false)
    isRejected      Boolean                                             @default(false)
    rejectionReason String?
    rejectedById    String?
    rejectedAt      TimestampString(3)?
    createdAt       TimestampString(3)                                        @default(now())
    updatedAt       temporal.timestampString(3, onCreate: now, onUpdate: now)
    categoryId      String
    posterFileId    String?
    posterUrl       String?
    tags            String[]?                                           @default([]) @noCheck(elementNotNull)
    freeleech       Boolean                                             @default(false)
    isAnonymous     Boolean                                             @default(false)
    announces       Announce[]
    bookmarks       Bookmark[]
    comments        Comment[]
    downloadTokens  DownloadToken[]
    hitAndRuns      HitAndRun[]
    requests        Request[]
    votes           TorrentVote[]
    uploader        User                                                @relation(name: "Torrent_uploader", fields: [uploaderId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    rejectedBy      User?                                               @relation(name: "Torrent_rejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)
    category        Category                                            @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    posterFile      UploadedFile?                                       @relation(fields: [posterFileId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)

    @@index([infoHash], map: "Torrent_infoHash_key", unique: true)
    @@index([posterFileId], map: "Torrent_posterFileId_key", unique: true)
  }

  model Announce {
    id             String       @id @default(uuid())
    torrentId      String
    userId         String?
    peerId         String
    ip             String
    port           Int
    uploaded       BigInt       @default(0)
    downloaded     BigInt       @default(0)
    left           BigInt       @default(0)
    event          String?
    lastAnnounceAt TimestampString(3) @default(now())
    torrent        Torrent      @relation(fields: [torrentId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)

    @@index([torrentId, peerId], map: "Announce_torrentId_peerId_key", unique: true)
  }

  model AnnounceRateLimit {
    id            String        @id @default(uuid())
    userId        String
    lastCheckedAt TimestampString(3)  @default(now())
    announceCount Int           @default(0)
    cooldownUntil TimestampString(3)?
    reason        String?
    user          User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)

    @@index([userId], map: "AnnounceRateLimit_userId_idx")
  }

  model Announcement {
    id          String                                              @id @default(uuid())
    title       String
    body        String
    createdAt   TimestampString(3)                                        @default(now())
    updatedAt   temporal.timestampString(3, onCreate: now, onUpdate: now)
    createdById String
    pinned      Boolean                                             @default(false)
    visible     Boolean                                             @default(true)
    createdBy   User                                                @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)

    @@index([pinned], map: "Announcement_pinned_idx")
    @@index([visible], map: "Announcement_visible_idx")
  }

  model Bookmark {
    id        String       @id @default(uuid())
    userId    String
    torrentId String
    createdAt TimestampString(3) @default(now())
    note      String?
    user      User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    torrent   Torrent      @relation(fields: [torrentId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)

    @@index([userId, torrentId], map: "Bookmark_userId_torrentId_key", unique: true)
  }

  model Source {
    id              String                                              @id @default(uuid())
    name            String
    isActive        Boolean                                             @default(true)
    createdAt       TimestampString(3)                                        @default(now())
    updatedAt       temporal.timestampString(3, onCreate: now, onUpdate: now)
    categorySources CategorySource[]

    @@index([name], map: "Source_name_key", unique: true)
  }

  model CategorySource {
    id          String                                              @id @default(uuid())
    categoryId  String
    sourceId    String
    isInherited Boolean                                             @default(false)
    order       Int                                                 @default(0)
    createdAt   TimestampString(3)                                        @default(now())
    updatedAt   temporal.timestampString(3, onCreate: now, onUpdate: now)
    category    Category                                            @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)
    source      Source                                              @relation(fields: [sourceId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)

    @@index([categoryId, sourceId], map: "CategorySource_categoryId_sourceId_key", unique: true)
    @@index([categoryId], map: "CategorySource_categoryId_idx")
    @@index([sourceId], map: "CategorySource_sourceId_idx")
    @@index([categoryId, order], map: "CategorySource_categoryId_order_idx")
  }

  model Request {
    id              String                                              @id @default(uuid())
    userId          String
    title           String
    description     String?
    status          pg.enum(RequestStatus)                              @default("OPEN")
    filledById      String?
    filledTorrentId String?
    categoryId      String?
    createdAt       TimestampString(3)                                        @default(now())
    updatedAt       temporal.timestampString(3, onCreate: now, onUpdate: now)
    comments        Comment[]
    user            User                                                @relation(name: "Request_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    filledBy        User?                                               @relation(name: "Request_filledBy", fields: [filledById], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)
    filledTorrent   Torrent?                                            @relation(fields: [filledTorrentId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)
    category        Category?                                           @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)
  }

  model Comment {
    id        String                                              @id @default(cuid(2))
    content   String
    createdAt TimestampString(3)                                        @default(now())
    updatedAt temporal.timestampString(3, onCreate: now, onUpdate: now)
    deleted   Boolean                                             @default(false)
    parentId  String?
    torrentId String?
    requestId String?
    userId    String
    votes     CommentVote[]
    parent    Comment?                                            @relation(name: "Comment_parent", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)
    torrent   Torrent?                                            @relation(fields: [torrentId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)
    request   Request?                                            @relation(fields: [requestId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)
    user      User                                                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    replies   Comment[]                                           @relation(name: "Comment_parent")
  }

  model CommentVote {
    id        String       @id @default(cuid(2))
    userId    String
    commentId String
    value     Int
    createdAt TimestampString(3) @default(now())
    user      User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    comment   Comment      @relation(fields: [commentId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)

    @@index([userId, commentId], map: "CommentVote_userId_commentId_key", unique: true)
  }

  model Config {
    id                        Int                  @id @default(1)
    registrationMode          pg.enum(RegMode)     @default("OPEN")
    storageType               pg.enum(StorageType) @default("DB")
    requireTorrentApproval    Boolean              @default(false)
    requiredSeedingMinutes    Int                  @default(4320)
    minRatio                  Float                @default(0.5)
    bonusPointsPerHour        Int                  @default(1)
    hitAndRunThreshold        Int                  @default(5)
    enableGhostLeechingCheck  Boolean              @default(true)
    enableCheatingClientCheck Boolean              @default(true)
    enableIpAbuseCheck        Boolean              @default(true)
    enableAnnounceRateCheck   Boolean              @default(true)
    enableInvalidStatsCheck   Boolean              @default(true)
    enablePeerBanCheck        Boolean              @default(true)
    whitelistedClients        String[]?            @default([]) @noCheck(elementNotNull)
    blacklistedClients        String[]?            @default([]) @noCheck(elementNotNull)
    allowedFingerprints       String[]?            @default([]) @noCheck(elementNotNull)
    defaultAnnounceInterval   Int                  @default(1800)
    minAnnounceInterval       Int                  @default(300)
    maxStatsJumpMultiplier    Int                  @default(10)
    smtpHost                  String?
    smtpPort                  Int?
    smtpUser                  String?
    smtpPass                  String?
    smtpFrom                  String?
    rssDefaultCount           Int                  @default(20)
    s3Bucket                  String?
    s3Region                  String?
    s3AccessKeyId             String?
    s3SecretAccessKey         String?
    brandingName              String?
    showHomePageStats         Boolean              @default(true)
    inviteExpiryHours         Int                  @default(6)
    maxInvitesPerUser         Int                  @default(5)
    ranksEnabled              Boolean              @default(true)
  }

  model DownloadToken {
    id        String       @id @default(uuid())
    token     String
    userId    String
    torrentId String
    expiresAt TimestampString(3)
    used      Boolean      @default(false)
    createdAt TimestampString(3) @default(now())
    user      User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)
    torrent   Torrent      @relation(fields: [torrentId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)

    @@index([token], map: "DownloadToken_token_key", unique: true)
    @@index([token], map: "DownloadToken_token_idx")
    @@index([expiresAt], map: "DownloadToken_expiresAt_idx")
  }

  model EmailVerificationToken {
    id        String       @id @default(uuid())
    userId    String
    token     String
    createdAt TimestampString(3) @default(now())
    expiresAt TimestampString(3)
    used      Boolean      @default(false)
    user      User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)

    @@index([token], map: "EmailVerificationToken_token_key", unique: true)
    @@index([userId], map: "EmailVerificationToken_userId_idx")
    @@index([token], map: "EmailVerificationToken_token_idx")
  }

  model HitAndRun {
    id               String        @id @default(uuid())
    userId           String
    torrentId        String
    downloadedAt     TimestampString(3)  @default(now())
    lastSeededAt     TimestampString(3)?
    totalSeedingTime Int           @default(0)
    isHitAndRun      Boolean       @default(false)
    user             User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    torrent          Torrent       @relation(fields: [torrentId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
  }

  model Invite {
    id          String        @id @default(uuid())
    code        String
    createdById String
    usedById    String?
    createdAt   TimestampString(3)  @default(now())
    usedAt      TimestampString(3)?
    expiresAt   TimestampString(3)?
    createdBy   User          @relation(name: "Invite_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    usedBy      User?         @relation(name: "Invite_usedBy", fields: [usedById], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)

    @@index([code], map: "Invite_code_key", unique: true)
  }

  model PeerBan {
    id            String         @id @default(uuid())
    userId        String?
    passkey       String?
    peerId        String?
    ip            String?
    reason        String
    expiresAt     TimestampString(3)?
    createdAt     TimestampString(3)   @default(now())
    bannedById    String
    notifications Notification[]
    bannedBy      User           @relation(fields: [bannedById], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)

    @@index([userId], map: "PeerBan_userId_idx")
    @@index([passkey], map: "PeerBan_passkey_idx")
    @@index([peerId], map: "PeerBan_peerId_idx")
    @@index([ip], map: "PeerBan_ip_idx")
    @@index([bannedById], map: "PeerBan_bannedById_idx")
  }

  model Notification {
    id           String       @id @default(uuid())
    userId       String
    type         String
    message      String
    read         Boolean      @default(false)
    createdAt    TimestampString(3) @default(now())
    relatedBanId String?
    adminId      String?
    user         User         @relation(name: "Notification_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    relatedBan   PeerBan?     @relation(fields: [relatedBanId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)
    admin        User?        @relation(name: "Notification_admin", fields: [adminId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)

    @@index([userId], map: "Notification_userId_idx")
    @@index([read], map: "Notification_read_idx")
  }

  model PasswordResetToken {
    id        String       @id @default(uuid())
    userId    String
    token     String
    createdAt TimestampString(3) @default(now())
    expiresAt TimestampString(3)
    used      Boolean      @default(false)
    user      User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)

    @@index([token], map: "PasswordResetToken_token_key", unique: true)
    @@index([userId], map: "PasswordResetToken_userId_idx")
    @@index([token], map: "PasswordResetToken_token_idx")
  }

  model Rank {
    id          String                                              @id @default(uuid())
    name        String
    description String?
    order       Int
    minUpload   BigInt                                              @default(0)
    minDownload BigInt                                              @default(0)
    minRatio    Float                                               @default(0)
    color       String?
    createdAt   TimestampString(3)                                        @default(now())
    updatedAt   temporal.timestampString(3, onCreate: now, onUpdate: now)

    @@index([name], map: "Rank_name_key", unique: true)
    @@index([order], map: "Rank_order_key", unique: true)
  }

  model TorrentVote {
    id        String       @id @default(cuid(2))
    userId    String
    torrentId String
    value     Int
    createdAt TimestampString(3) @default(now())
    user      User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    torrent   Torrent      @relation(fields: [torrentId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)

    @@index([userId, torrentId], map: "TorrentVote_userId_torrentId_key", unique: true)
  }

  model UserActivity {
    id         String       @id @default(uuid())
    userId     String
    type       String
    entityType String?
    entityId   String?
    title      String
    subtitle   String?
    metadata   Jsonb?
    createdAt  TimestampString(3) @default(now())
    user       User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)

    @@index([userId], map: "UserActivity_userId_idx")
    @@index([userId, createdAt], map: "UserActivity_userId_createdAt_idx")
    @@index([type], map: "UserActivity_type_idx")
  }

  model WikiPage {
    id          String                                              @id @default(uuid())
    slug        String
    title       String
    content     String
    createdAt   TimestampString(3)                                        @default(now())
    updatedAt   temporal.timestampString(3, onCreate: now, onUpdate: now)
    createdById String
    updatedById String
    visible     Boolean                                             @default(true)
    locked      Boolean                                             @default(false)
    parentId    String?
    createdBy   User                                                @relation(name: "WikiPage_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    updatedBy   User                                                @relation(name: "WikiPage_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    parent      WikiPage?                                           @relation(name: "WikiPage_parent", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)
    children    WikiPage[]                                          @relation(name: "WikiPage_parent")

    @@index([slug], map: "WikiPage_slug_key", unique: true)
    @@index([slug], map: "WikiPage_slug_idx")
    @@index([visible], map: "WikiPage_visible_idx")
    @@index([locked], map: "WikiPage_locked_idx")
  }

  native_enum UserRole {
    USER = "USER"
    MOD = "MOD"
    ADMIN = "ADMIN"
    OWNER = "OWNER"
    FOUNDER = "FOUNDER"
  }

  native_enum UserStatus {
    ACTIVE = "ACTIVE"
    BANNED = "BANNED"
    DISABLED = "DISABLED"
  }

  native_enum RegMode {
    OPEN = "OPEN"
    INVITE = "INVITE"
    CLOSED = "CLOSED"
  }

  native_enum StorageType {
    LOCAL = "LOCAL"
    S3 = "S3"
    DB = "DB"
  }

  native_enum RequestStatus {
    OPEN = "OPEN"
    FILLED = "FILLED"
    CLOSED = "CLOSED"
    REJECTED = "REJECTED"
  }
}
